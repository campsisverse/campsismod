{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campsisverse.github.io/campsis.doc/schema/2.0/campsismod.schema.json",
  "$comment": "Campsismod JSON Schema v2.0 \u00a9 2026 [Nicolas Luyckx / Calvagone]. Licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).",
  "title": "Campsismod JSON Schema",
  "$ref": "#/$defs/model",
  "$defs": {
    "model": {
      "type": "object",
      "properties": {
        "version": {
          "const": "2.0",
          "description": "Version of the Campsismod JSON format"
        },
        "main": {
          "type": "array",
          "description": "Main block: assignments, IF-statements, comments and blank lines",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/assignment"
              },
              {
                "$ref": "#/$defs/if_statement"
              },
              {
                "$ref": "#/$defs/comment"
              },
              {
                "$ref": "#/$defs/blank"
              }
            ]
          }
        },
        "ode": {
          "type": "array",
          "description": "ODE block: derivatives, assignments, IF-statements, comments and blank lines",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/derivative"
              },
              {
                "$ref": "#/$defs/assignment"
              },
              {
                "$ref": "#/$defs/if_statement"
              },
              {
                "$ref": "#/$defs/comment"
              },
              {
                "$ref": "#/$defs/blank"
              }
            ]
          }
        },
        "f": {
          "$ref": "#/$defs/compartment_property_map",
          "description": "Bioavailability per compartment"
        },
        "lag": {
          "$ref": "#/$defs/compartment_property_map",
          "description": "Lag time per compartment"
        },
        "duration": {
          "$ref": "#/$defs/compartment_property_map",
          "description": "Infusion duration per compartment"
        },
        "rate": {
          "$ref": "#/$defs/compartment_property_map",
          "description": "Infusion rate per compartment"
        },
        "init": {
          "$ref": "#/$defs/compartment_property_map",
          "description": "Initial condition per compartment"
        },
        "endpoints": {
          "type": "array",
          "description": "Structured residual error models (mutually exclusive with 'error')",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "error": {
          "type": "array",
          "description": "Raw [ERROR] block code lines (mutually exclusive with 'endpoints')",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/theta"
              },
              {
                "$ref": "#/$defs/omega"
              },
              {
                "$ref": "#/$defs/sigma"
              }
            ],
            "discriminator": {
              "propertyName": "type"
            }
          }
        },
        "covariates": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/continuous_covariate_definition"
              },
              {
                "$ref": "#/$defs/categorical_covariate_definition"
              }
            ]
          }
        },
        "varcov": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/varcov_entry",
            "description": "Variance-covariance entry list"
          }
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "endpoints",
          "error"
        ]
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "compartment_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "pattern": "^A_"
      },
      "description": "Compartment name, without the legacy 'A_' prefix"
    },
    "assignment": {
      "title": "Assignment",
      "type": "object",
      "properties": {
        "lhs": {
          "$ref": "#/$defs/identifier"
        },
        "rhs": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "lhs",
        "rhs"
      ],
      "additionalProperties": false
    },
    "derivative": {
      "title": "Derivative of a compartment amount",
      "type": "object",
      "properties": {
        "compartment": {
          "$ref": "#/$defs/compartment_name"
        },
        "rate": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "compartment",
        "rate"
      ],
      "additionalProperties": false
    },
    "if_statement": {
      "title": "IF-statement",
      "type": "object",
      "properties": {
        "type": {
          "const": "if"
        },
        "condition": {
          "type": "string"
        },
        "then": {
          "type": "object",
          "properties": {
            "lhs": {
              "$ref": "#/$defs/identifier"
            },
            "rhs": {
              "type": "string"
            }
          },
          "required": [
            "lhs",
            "rhs"
          ],
          "additionalProperties": false
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "condition",
        "then"
      ],
      "additionalProperties": false
    },
    "comment": {
      "title": "Standalone comment",
      "type": "object",
      "properties": {
        "type": {
          "const": "comment"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "blank": {
      "title": "Blank line",
      "type": "object",
      "properties": {
        "type": {
          "const": "blank"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "compartment_property_map": {
      "title": "Compartment property map",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/compartment_name"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "rhs": {
                "type": "string"
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "rhs"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "endpoint": {
      "title": "Structured endpoint (residual error model)",
      "description": "Residual error model aligned with nlmixr2: 'theta_add' and 'theta_prop' are standard deviations (THETA parameters), 'sigma' is a unit-variance SIGMA parameter.",
      "type": "object",
      "properties": {
        "variable": {
          "$ref": "#/$defs/identifier",
          "description": "Model prediction the error is applied to"
        },
        "output": {
          "$ref": "#/$defs/identifier",
          "description": "Output variable name, default is '<variable>_ERR'"
        },
        "error_model": {
          "enum": [
            "additive",
            "proportional",
            "combined1",
            "combined2"
          ]
        },
        "theta_add": {
          "$ref": "#/$defs/identifier",
          "description": "Name of the THETA parameter holding the additive standard deviation"
        },
        "theta_prop": {
          "$ref": "#/$defs/identifier",
          "description": "Name of the THETA parameter holding the proportional standard deviation"
        },
        "sigma": {
          "$ref": "#/$defs/identifier",
          "description": "Name of the SIGMA parameter (unit variance)"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "variable",
        "error_model",
        "sigma"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "error_model": {
                "const": "additive"
              }
            }
          },
          "then": {
            "required": [
              "theta_add"
            ],
            "not": {
              "required": [
                "theta_prop"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_model": {
                "const": "proportional"
              }
            }
          },
          "then": {
            "required": [
              "theta_prop"
            ],
            "not": {
              "required": [
                "theta_add"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_model": {
                "enum": [
                  "combined1",
                  "combined2"
                ]
              }
            }
          },
          "then": {
            "required": [
              "theta_add",
              "theta_prop"
            ]
          }
        }
      ]
    },
    "parameter": {
      "title": "Base Parameter",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the parameter"
        },
        "value": {
          "type": "number",
          "description": "Numeric value of the parameter"
        },
        "min": {
          "type": "number",
          "description": "Minimum value of the parameter"
        },
        "max": {
          "type": "number",
          "description": "Maximum value of the parameter"
        },
        "label": {
          "type": "string",
          "description": "Short description of the parameter"
        },
        "comment": {
          "type": "string",
          "description": "Any additional comment"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "theta": {
      "title": "Theta Parameter",
      "allOf": [
        {
          "$ref": "#/$defs/parameter"
        },
        {
          "properties": {
            "type": {
              "const": "theta",
              "default": "theta"
            },
            "unit": {
              "type": "string",
              "description": "Unit of the parameter"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "double_array_parameter": {
      "title": "Double Array Parameter",
      "allOf": [
        {
          "$ref": "#/$defs/parameter"
        },
        {
          "properties": {
            "var_type": {
              "enum": [
                "cv%",
                "cv",
                "var",
                "sd",
                "covar",
                "cor"
              ]
            },
            "name2": {
              "type": "string",
              "description": "Reference to the second parameter in case this parameter describes a correlation or a covariance."
            }
          },
          "required": [
            "var_type"
          ]
        }
      ]
    },
    "omega": {
      "title": "Omega Parameter",
      "allOf": [
        {
          "$ref": "#/$defs/double_array_parameter"
        },
        {
          "properties": {
            "type": {
              "const": "omega",
              "default": "omega"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "sigma": {
      "title": "Sigma Parameter",
      "allOf": [
        {
          "$ref": "#/$defs/double_array_parameter"
        },
        {
          "properties": {
            "type": {
              "const": "sigma",
              "default": "sigma"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "parameter_ref": {
      "title": "Base Parameter Reference",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the referenced parameter"
        }
      },
      "required": [
        "name"
      ]
    },
    "theta_ref": {
      "title": "Theta Parameter Reference",
      "allOf": [
        {
          "$ref": "#/$defs/parameter_ref"
        },
        {
          "properties": {
            "type": {
              "const": "theta_ref",
              "default": "theta_ref"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "double_array_parameter_ref": {
      "title": "Double Array Parameter Reference",
      "allOf": [
        {
          "$ref": "#/$defs/parameter_ref"
        },
        {
          "properties": {
            "name2": {
              "type": "string",
              "description": "Reference to the second parameter in case this parameter describes a correlation or a covariance."
            }
          },
          "required": []
        }
      ]
    },
    "omega_ref": {
      "title": "Omega Parameter Reference",
      "allOf": [
        {
          "$ref": "#/$defs/double_array_parameter_ref"
        },
        {
          "properties": {
            "type": {
              "const": "omega_ref",
              "default": "omega_ref"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "sigma_ref": {
      "title": "Sigma Parameter Reference",
      "allOf": [
        {
          "$ref": "#/$defs/double_array_parameter_ref"
        },
        {
          "properties": {
            "type": {
              "const": "sigma_ref",
              "default": "sigma_ref"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "varcov_entry": {
      "title": "Variance-Covariance Matrix Entry",
      "type": "object",
      "properties": {
        "type": {
          "const": "varcov_entry"
        },
        "ref1": {
          "oneOf": [
            {
              "$ref": "#/$defs/theta_ref"
            },
            {
              "$ref": "#/$defs/omega_ref"
            },
            {
              "$ref": "#/$defs/sigma_ref"
            }
          ],
          "discriminator": {
            "propertyName": "type"
          },
          "description": "First referenced parameter"
        },
        "ref2": {
          "oneOf": [
            {
              "$ref": "#/$defs/theta_ref"
            },
            {
              "$ref": "#/$defs/omega_ref"
            },
            {
              "$ref": "#/$defs/sigma_ref"
            }
          ],
          "discriminator": {
            "propertyName": "type"
          },
          "description": "Second referenced parameter"
        },
        "cov": {
          "type": "number",
          "description": "Covariance value between the two referenced parameters."
        }
      },
      "required": [
        "type",
        "ref1",
        "ref2",
        "cov"
      ]
    },
    "covariate_definition": {
      "title": "Base Covariate Definition",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the covariate"
        },
        "default_value": {
          "type": "number",
          "description": "Default value of the covariate"
        },
        "label": {
          "type": "string",
          "description": "Short description of the covariate"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the covariate"
        }
      },
      "required": [
        "name",
        "default_value"
      ]
    },
    "continuous_covariate_definition": {
      "title": "Continuous Covariate Definition",
      "allOf": [
        {
          "$ref": "#/$defs/covariate_definition"
        },
        {
          "properties": {
            "type": {
              "const": "continuous_covariate_definition",
              "default": "continuous_covariate_definition"
            },
            "unit": {
              "type": "string",
              "description": "Unit of the covariate"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "categorical_covariate_definition": {
      "title": "Categorical Covariate Definition",
      "allOf": [
        {
          "$ref": "#/$defs/covariate_definition"
        },
        {
          "properties": {
            "type": {
              "const": "categorical_covariate_definition",
              "default": "categorical_covariate_definition"
            },
            "categories": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Mapping of category labels to numeric values"
            }
          },
          "required": [
            "type",
            "categories"
          ]
        }
      ]
    }
  }
}
